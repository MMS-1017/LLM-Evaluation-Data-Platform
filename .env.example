# ═══════════════════════════════════════════════════════════════════════════════
# LLM Evaluation Data Platform — Environment Variables
# Copy this file to .env and fill in your values.
# ═══════════════════════════════════════════════════════════════════════════════

# ── Embedding ─────────────────────────────────────────────────────────────────
# Use "huggingface" (no API key) or "openai"
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=64
EMBEDDING_DIMENSION=384

# ── LLM (answer generation) ───────────────────────────────────────────────────
# Use "huggingface" (local, no API key) or "openai"
LLM_PROVIDER=huggingface
LLM_MODEL=google/flan-t5-base
# Uncomment and set your key to use OpenAI:
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-3.5-turbo
# OPENAI_API_KEY=sk-...

# ── Qdrant Vector Store ───────────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=llm_eval_docs
# QDRANT_API_KEY=...  # Only needed for Qdrant Cloud

# ── MLflow Tracking ───────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=llm_eval_platform

# ── Apache Spark ──────────────────────────────────────────────────────────────
SPARK_MASTER=local[*]
SPARK_APP_NAME=LLMEvalPlatform
SPARK_EXECUTOR_MEMORY=2g
SPARK_DRIVER_MEMORY=2g

# ── Data Paths (relative to project root) ────────────────────────────────────
# DATA_RAW_DIR=data/raw
# DATA_BRONZE_DIR=data/bronze
# DATA_SILVER_DIR=data/silver
# DATA_GOLD_DIR=data/gold

# ── Chunking ──────────────────────────────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=64
MIN_CHUNK_LENGTH=50

# ── Evaluation ────────────────────────────────────────────────────────────────
EVAL_TEST_SET_SIZE=20

# ── FastAPI ───────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
API_TOP_K=5
