FROM python:3.11-slim

LABEL maintainer="ai-engineering@company.com"
LABEL description="LLM Eval Platform — FastAPI RAG service"

WORKDIR /app

# System dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies first (better layer caching)
COPY pyproject.toml README.md ./
RUN pip install --no-cache-dir --upgrade pip \
 && pip install --no-cache-dir -e ".[ai,api,config,logging]"

# Copy source code
COPY src/ ./src/
COPY services/ ./services/
COPY pipelines/ ./pipelines/
COPY configs/ ./configs/

# Create data and log directories
RUN mkdir -p data/raw data/bronze data/silver data/gold logs

# Non-root user for security
RUN useradd -m -u 1000 appuser && chown -R appuser:appuser /app
USER appuser

HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

EXPOSE 8000

CMD ["python", "-m", "uvicorn", "services.api.main:app", \
     "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
